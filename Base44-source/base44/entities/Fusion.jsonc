{
  "name": "Fusion",
  "type": "object",
  "properties": {
    "parents": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Array of Monster IDs that were fused together"
    },
    "fusedName": {
      "type": "string",
      "description": "The name of the fused monster"
    },
    "stats": {
      "type": "object",
      "properties": {
        "hp": {
          "type": "number"
        },
        "attack": {
          "type": "number"
        },
        "defense": {
          "type": "number"
        },
        "speed": {
          "type": "number"
        }
      },
      "required": [
        "hp",
        "attack",
        "defense",
        "speed"
      ],
      "description": "Combined and calculated stats of the fused monster"
    },
    "level": {
      "type": "number",
      "default": 1,
      "description": "Current level of the fusion monster"
    },
    "levelBonus": {
      "type": "object",
      "properties": {
        "hp": {
          "type": "number",
          "default": 0
        },
        "attack": {
          "type": "number",
          "default": 0
        },
        "defense": {
          "type": "number",
          "default": 0
        },
        "speed": {
          "type": "number",
          "default": 0
        }
      },
      "description": "Bonus stats gained from leveling up"
    },
    "talentBonus": {
      "type": "object",
      "properties": {
        "hp": {
          "type": "number",
          "default": 0
        },
        "attack": {
          "type": "number",
          "default": 0
        },
        "defense": {
          "type": "number",
          "default": 0
        },
        "speed": {
          "type": "number",
          "default": 0
        }
      },
      "description": "Bonus stats gained from learned talents"
    },
    "generatedImage": {
      "type": "string",
      "description": "URL to the generated fusion monster image"
    },
    "playerOwner": {
      "type": "string",
      "description": "User ID of the player who owns this fusion"
    },
    "abilities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Array of Ability IDs that this fusion can use"
    },
    "rarity": {
      "type": "string",
      "enum": [
        "Ephemeral",
        "Uncanny",
        "Abyssal",
        "Cosmic",
        "Outer"
      ],
      "default": "Ephemeral",
      "description": "The cosmic rarity of the fusion, affecting its base stats."
    },
    "originType": {
      "type": "string",
      "enum": [
        "Void",
        "Dream",
        "Flesh",
        "Sunken",
        "Dimension"
      ],
      "description": "The dominant origin type of the fusion, determining its combat synergies."
    },
    "orbSlots": {
      "type": "number",
      "default": 1,
      "description": "Number of orb slots available for this fusion"
    },
    "equippedOrbs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Array of Orb IDs currently equipped to this fusion"
    },
    "ascensionLevel": {
      "type": "number",
      "default": 0,
      "description": "The star-based ascension level of the fusion (0-5)."
    }
  },
  "required": [
    "fusedName",
    "stats",
    "abilities"
  ],
  "rls": {
    "write": {
      "$or": [
        {
          "data.playerOwner": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}